#!/bin/bash
set -e

plugins="$(git diff --cached --name-only -- plugins/ | cut -d'/' -f2 | sort -u)"
[ -z "$plugins" ] && exit 0

# `git commit <path>` commits a temporary next-index-*.lock and rewrites the real index afterwards, so a bump
# staged here would be missing from the real index and reverted by the next commit. CI bumps on merge instead.
case "$(basename "${GIT_INDEX_FILE:-}")" in
  next-index-*.lock)
    echo "pre-commit: 'git commit <path>' cannot stage a plugin version bump, skipping it." >&2
    exit 0
    ;;
esac

base="$(git merge-base HEAD main)"

manifests() {
  for plugin in $plugins; do
    manifest="plugins/$plugin/.claude-plugin/plugin.json"
    if [ -f "$manifest" ]; then echo "$manifest $(git hash-object "$manifest")"; fi
  done
}

before="$(manifests)"

for plugin in $plugins; do
  git show "$base:plugins/$plugin/.claude-plugin/plugin.json" 2>/dev/null || true
done | docker run \
  --rm \
  --interactive \
  --user "$(id -u):$(id -g)" \
  --volume "$PWD:/workspace" \
  --workdir /workspace \
  ghcr.io/specsnl/utils:1.17.0 \
  bash .githooks/bump-versions.sh $plugins

manifests | while read -r manifest hash; do
  grep --quiet --line-regexp --fixed-strings "$manifest $hash" <<< "$before" || git add "$manifest"
done
